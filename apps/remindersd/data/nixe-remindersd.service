[Unit]
Description=Nixe Reminders alerts
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nixe-remindersd
Restart=on-failure
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical-session.target
